# card-capture CUDA base image — linux/amd64 target (vast.ai / RunPod instances are x86_64)
#
# Multi-stage build:
#   Stage 1 (decord-builder): compiles decord with CUDA/NVDEC from source using the
#     DEVEL image (which has nvcc + CUDA headers). Produces a Python wheel.
#   Stage 2 (final): RUNTIME image (smaller). Copies the CUDA-enabled decord wheel
#     from Stage 1 so we get NVDEC support without shipping a full DEVEL environment.
#
# The pip-installed decord from PyPI is compiled without NVDEC. Building from source
# with USE_CUDA=ON enables hardware-accelerated video decode which is critical for
# large 4K video files.

# ── Stage 1: build NVDEC-enabled decord ──────────────────────────────────────
FROM pytorch/pytorch:2.3.0-cuda12.1-cudnn8-devel AS decord-builder

ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1

RUN apt-get update -q && \
    apt-get install -y -q --no-install-recommends \
        cmake build-essential git \
        libavcodec-dev libavdevice-dev libavfilter-dev libavformat-dev libavutil-dev libswscale-dev \
    && rm -rf /var/lib/apt/lists/*

# NVIDIA removed nvcuvid.h and libnvcuvid.so from the CUDA toolkit in 11.1+.
# They ship as a separate Video Codec SDK download. The endorsed approach for
# headless builds is a stub .so — cmake find_library() and the linker are satisfied;
# at runtime on RunPod the real libnvcuvid.so.1 from the NVIDIA driver mount is used.
RUN printf 'void nvcuvid_stub(void) {}' > /tmp/stub.c && \
    gcc -shared -fPIC -o /usr/local/cuda/lib64/stubs/libnvcuvid.so /tmp/stub.c && \
    rm /tmp/stub.c

# Clone decord and build with CUDA/NVDEC support.
RUN git clone --recursive https://github.com/dmlc/decord /tmp/decord && \
    cd /tmp/decord && mkdir build && cd build && \
    cmake .. -DUSE_CUDA=ON -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && \
    cd /tmp/decord/python && \
    pip wheel . --wheel-dir /tmp/decord-wheels

# ── Stage 2: final runtime image ─────────────────────────────────────────────
FROM pytorch/pytorch:2.3.0-cuda12.1-cudnn8-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# Copy the CUDA-enabled decord wheel built in Stage 1
COPY --from=decord-builder /tmp/decord-wheels/decord*.whl /tmp/

# All system + Python deps in one layer to minimise image size.
# runtime (not devel) includes CUDA runtime libs sufficient for PyTorch/Kornia inference.
# decord's NVDEC requires libnvcuvid.so — provided at runtime by the NVIDIA driver mount.
# decord is compiled against GCC 12 (GLIBCXX_3.4.30) but conda ships an older
# libstdc++. Upgrade it so the decord wheel loads correctly at runtime.
RUN conda install -y -q -c conda-forge libstdcxx-ng && conda clean -afy

RUN apt-get update -q && \
    apt-get install -y -q --no-install-recommends \
        git ffmpeg libsm6 libxext6 libgl1 \
    && rm -rf /var/lib/apt/lists/* && \
    pip install /tmp/decord*.whl && rm /tmp/decord*.whl && \
    pip install \
        "av>=12.0.0" \
        "ultralytics>=8.1.0" \
        "kornia>=0.7.2" \
        "httpx>=0.27.0" \
        "fastapi>=0.110.0" \
        "uvicorn[standard]>=0.29.0" \
        "python-multipart>=0.0.9" \
        "python-dotenv>=1.0.0" \
        "metaflow>=2.10.0" \
        "faiss-cpu>=1.7.4" && \
    pip install torch==2.3.0 torchvision==0.18.0 \
        --index-url https://download.pytorch.org/whl/cu121 \
        --force-reinstall

# Clone repo and install the app layer (heavy ML deps already above).
# torch/torchvision are NOT in pyproject.toml — the base image provides them.
RUN git clone https://github.com/jpglick/card-capture.git /workspace/card-capture
WORKDIR /workspace/card-capture
RUN pip install -e ".[model,app]"

# Pre-download models so cold starts don't pay the download cost.
# YOLO weights (~160 MB) from HuggingFace; DINOv2 ViT-S/14 (~330 MB) from torch.hub.
# Both are cached to ~/.cache/{huggingface,torch/hub} in the image layer.
RUN python3 -c "\
from huggingface_hub import hf_hub_download; \
hf_hub_download(repo_id='AlecKarfonta/cardcaptor-v3', filename='weights/cardcaptor_v3_best.pt'); \
import torch; \
torch.hub.load('facebookresearch/dinov2', 'dinov2_vits14', pretrained=True); \
print('Models pre-downloaded OK')"

COPY docker/start.sh /start.sh
RUN chmod +x /start.sh
ENTRYPOINT ["/start.sh"]
