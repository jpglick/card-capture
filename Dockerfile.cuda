# card-capture CUDA image — linux/amd64, RunPod target.
#
# Uses RunPod's own pytorch base, which is built and validated against their
# container runtime's NVIDIA driver mount. Sidesteps the conda RPATH games
# and libnvcuvid stub gymnastics that plagued the pytorch/pytorch base
# (commits eac6ae5b … d71b0243). Confirmed working on a dev pod: import decord,
# decord.gpu(0), and NVDEC frame open all succeed without surgery.

FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

# Request the 'video' driver capability so nvidia-container-toolkit mounts
# the /dev/nvidia-* nodes that NVDEC needs. Without this, decord's nvcodec
# layer hits "CUDA error 100: no CUDA-capable device" even though
# torch.cuda.is_available() returns True (PyTorch only needs 'compute').
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

# System deps: decord build toolchain (cmake, gcc, libav*-dev), ffmpeg runtime
# libs, OpenCV runtime helpers, and patchelf (used below to fix libdecord.so's
# DT_NEEDED). Single layer so the apt cache is dropped at the end.
RUN apt-get update -q && \
    apt-get install -y -q --no-install-recommends \
        cmake build-essential git patchelf \
        libavcodec-dev libavdevice-dev libavfilter-dev libavformat-dev libavutil-dev libswscale-dev \
        ffmpeg libsm6 libxext6 libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Build decord from source with NVDEC. The pip wheel from PyPI is compiled
# without CUDA — we need USE_CUDA=ON for hardware video decode on 4K input.
#
# libnvcuvid: ships with the NVIDIA driver, not the CUDA toolkit. On a GPU
# host, nvidia-container-toolkit mounts libnvcuvid.so.1 into the container at
# runtime. But `docker build` runs without a GPU mount, so cmake can't find
# it — we provide a minimal stub for build-time linking only. SONAME is set
# to libnvcuvid.so.1 so libdecord.so records DT_NEEDED=libnvcuvid.so.1, which
# the dynamic linker then resolves to the real driver-mounted lib at runtime.
# The stub is DELETED at the end of this RUN so it cannot shadow the real
# lib at runtime (the failure mode that ate ~10 commits on the pytorch/pytorch
# base; commit history: eac6ae5b … d71b0243).
RUN printf 'void nvcuvid_stub(void) {}' > /tmp/stub.c && \
    mkdir -p /usr/local/cuda/lib64/stubs && \
    gcc -shared -fPIC -Wl,-soname,libnvcuvid.so.1 \
        -o /usr/local/cuda/lib64/stubs/libnvcuvid.so /tmp/stub.c && \
    rm /tmp/stub.c && \
    git clone --recursive https://github.com/dmlc/decord /tmp/decord && \
    cd /tmp/decord && mkdir build && cd build && \
    cmake .. -DUSE_CUDA=ON -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && \
    cd /tmp/decord/python && \
    pip install . && \
    cd / && rm -rf /tmp/decord && \
    # patchelf libnvcuvid.so.1 INTO libdecord.so's DT_NEEDED. Our minimal stub
    # has only one symbol (nvcuvid_stub) so the linker (modern gcc defaults to
    # --as-needed) dropped the libnvcuvid dependency entirely. Without DT_NEEDED,
    # ld.so never loads the real driver-mounted libnvcuvid.so.1 at runtime and
    # `import decord` fails with "undefined symbol: cuvidDestroyDecoder" even
    # though /usr/lib/x86_64-linux-gnu/libnvcuvid.so.1 is mounted and HAS the
    # symbol. Diagnosed by readelf + LD_PRELOAD on a dev pod from this image.
    patchelf --add-needed libnvcuvid.so.1 \
        /usr/local/lib/python3.11/dist-packages/decord/libdecord.so && \
    rm -f /usr/local/cuda/lib64/stubs/libnvcuvid.so && \
    ldconfig

# Python deps. torch + torchvision come from the base image (cu124). Everything
# else listed in one layer; pyproject's [model,app] extras pull the same set
# but pinning here makes the layer cacheable independent of repo state.
RUN pip install \
        "av>=12.0.0" \
        "ultralytics>=8.1.0" \
        "kornia>=0.7.2" \
        "httpx>=0.27.0" \
        "fastapi>=0.110.0" \
        "uvicorn[standard]>=0.29.0" \
        "python-multipart>=0.0.9" \
        "python-dotenv>=1.0.0" \
        "metaflow>=2.10.0" \
        "faiss-cpu>=1.7.4" \
        "runpod>=1.7.0"

# App layer.
RUN git clone https://github.com/jpglick/card-capture.git /workspace/card-capture
WORKDIR /workspace/card-capture
RUN pip install -e ".[model,app]"

# Pre-download models so cold starts don't pay the download cost.
# YOLO weights (~160 MB) from HuggingFace; DINOv2 ViT-S/14 (~330 MB) from torch.hub.
RUN python3 -c "\
from huggingface_hub import hf_hub_download; \
hf_hub_download(repo_id='AlecKarfonta/cardcaptor-v3', filename='weights/cardcaptor_v3_best.pt'); \
import torch; \
torch.hub.load('facebookresearch/dinov2', 'dinov2_vits14', pretrained=True); \
print('Models pre-downloaded OK')"

COPY docker/start.sh /start.sh
RUN chmod +x /start.sh
ENTRYPOINT ["/start.sh"]
