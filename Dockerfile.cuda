# card-capture CUDA base image — linux/amd64 target (vast.ai instances are x86_64)
# Generated by scripts/setup_cuda_template.py — edit that script to change this.
#
# Size reduction vs previous version:
#   - pytorch runtime (not devel): saves ~8GB of CUDA dev headers/compiler/libs
#   - single consolidated RUN: eliminates duplicate layer metadata
#   - no model pre-caching: models download at first inference (~500MB, cached on instance)
#   - total: ~7-9GB compressed vs ~13GB previously

FROM pytorch/pytorch:2.3.0-cuda12.1-cudnn8-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# All system + Python deps in one layer to minimise image size.
# runtime (not devel) includes CUDA runtime libs sufficient for PyTorch/decord/kornia inference.
RUN apt-get update -q && \
    apt-get install -y -q --no-install-recommends \
        git ffmpeg libsm6 libxext6 libgl1 \
    && rm -rf /var/lib/apt/lists/* && \
    pip install \
        "decord>=0.6.0" \
        "ultralytics>=8.1.0" \
        "kornia>=0.7.2" \
        "httpx>=0.27.0" \
        "fastapi>=0.110.0" \
        "uvicorn[standard]>=0.29.0" \
        "python-multipart>=0.0.9" \
        "python-dotenv>=1.0.0"

# Clone repo and install the app layer (heavy ML deps already above)
RUN git clone https://github.com/jpglick/card-capture.git /workspace/card-capture
WORKDIR /workspace/card-capture
RUN pip install -e ".[model,app]"

# Models (YOLO ~160MB, DINOv2 ~330MB) are NOT pre-cached — they download on
# first inference and are then cached in ~/.cache on the instance disk.
# This saves ~500MB from the image at the cost of ~1-2min on the very first run.

# On each boot the vastai_worker onstart script runs:
#   git pull origin main -q && pip install -e '.[app]' -q &&
#   uvicorn app.vastai_worker:app --host 0.0.0.0 --port 8765
# The CMD below is only used when running outside vast.ai.
CMD ["uvicorn", "app.vastai_worker:app", "--host", "0.0.0.0", "--port", "8765"]
