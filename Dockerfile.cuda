# card-capture CUDA image — linux/amd64, RunPod target.
#
# Uses RunPod's own pytorch base, which is built and validated against their
# container runtime's NVIDIA driver mount. Sidesteps the conda RPATH games
# and libnvcuvid stub gymnastics that plagued the pytorch/pytorch base
# (commits eac6ae5b … d71b0243). Confirmed working on a dev pod: import decord,
# decord.gpu(0), and NVDEC frame open all succeed without surgery.

FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

# Request the 'video' driver capability so nvidia-container-toolkit mounts
# the /dev/nvidia-* nodes that NVDEC needs. Without this, decord's nvcodec
# layer hits "CUDA error 100: no CUDA-capable device" even though
# torch.cuda.is_available() returns True (PyTorch only needs 'compute').
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

# System deps: decord build toolchain + ffmpeg libs (build-time + runtime) +
# OpenCV runtime helpers. Single layer so the apt cache is dropped at the end.
RUN apt-get update -q && \
    apt-get install -y -q --no-install-recommends \
        cmake build-essential git \
        libavcodec-dev libavdevice-dev libavfilter-dev libavformat-dev libavutil-dev libswscale-dev \
        ffmpeg libsm6 libxext6 libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Build decord from source with NVDEC. The pip wheel from PyPI is compiled
# without CUDA — we need USE_CUDA=ON for hardware video decode on 4K input.
# The runpod base provides libnvcuvid for build-time linking; the real lib is
# mounted at runtime by NVIDIA's container runtime (proven on dev pod).
RUN git clone --recursive https://github.com/dmlc/decord /tmp/decord && \
    cd /tmp/decord && mkdir build && cd build && \
    cmake .. -DUSE_CUDA=ON -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc) && \
    cd /tmp/decord/python && \
    pip install . && \
    cd / && rm -rf /tmp/decord

# Python deps. torch + torchvision come from the base image (cu124). Everything
# else listed in one layer; pyproject's [model,app] extras pull the same set
# but pinning here makes the layer cacheable independent of repo state.
RUN pip install \
        "av>=12.0.0" \
        "ultralytics>=8.1.0" \
        "kornia>=0.7.2" \
        "httpx>=0.27.0" \
        "fastapi>=0.110.0" \
        "uvicorn[standard]>=0.29.0" \
        "python-multipart>=0.0.9" \
        "python-dotenv>=1.0.0" \
        "metaflow>=2.10.0" \
        "faiss-cpu>=1.7.4" \
        "runpod>=1.7.0"

# App layer.
RUN git clone https://github.com/jpglick/card-capture.git /workspace/card-capture
WORKDIR /workspace/card-capture
RUN pip install -e ".[model,app]"

# Pre-download models so cold starts don't pay the download cost.
# YOLO weights (~160 MB) from HuggingFace; DINOv2 ViT-S/14 (~330 MB) from torch.hub.
RUN python3 -c "\
from huggingface_hub import hf_hub_download; \
hf_hub_download(repo_id='AlecKarfonta/cardcaptor-v3', filename='weights/cardcaptor_v3_best.pt'); \
import torch; \
torch.hub.load('facebookresearch/dinov2', 'dinov2_vits14', pretrained=True); \
print('Models pre-downloaded OK')"

COPY docker/start.sh /start.sh
RUN chmod +x /start.sh
ENTRYPOINT ["/start.sh"]
