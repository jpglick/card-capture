[importlinter]
root_packages =
    card_capture
    app
    pipeline
include_external_packages = True

[importlinter:contract:no-sqlite3-outside-data]
name = sqlite3 only inside card_capture.data and migrations
type = forbidden
source_modules =
    card_capture.runtime
forbidden_modules =
    sqlite3

[importlinter:contract:no-provider-sdks]
name = provider SDKs (runpod/beam) must not be imported anywhere
type = forbidden
source_modules =
    card_capture
    app
forbidden_modules =
    runpod
    beam

[importlinter:contract:strict-gpu-no-image-io]
name = strict GPU code must not import OpenCV/PIL file IO
type = forbidden
source_modules =
    card_capture.runtime.strict_gpu
forbidden_modules =
    PIL
    cv2

[importlinter:contract:layered]
name = layered architecture
type = layers
containers =
    card_capture
layers =
    runtime
    pipeline
    data

[importlinter:contract:no-metaflow]
name = metaflow must not be imported anywhere
type = forbidden
source_modules =
    card_capture
    app
forbidden_modules =
    metaflow
